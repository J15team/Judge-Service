<mxfile host="app.diagrams.net">
  <diagram name="Judge Service Architecture" id="judge-arch">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="850">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        
        <!-- VPC -->
        <mxCell id="vpc" value="VPC (vpc-06697d3c25e917ebd)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;verticalAlign=top;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="50" y="50" width="1000" height="700" as="geometry" />
        </mxCell>
        
        <!-- Public Subnet -->
        <mxCell id="subnet" value="Public Subnet (10.0.1.0/24)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;verticalAlign=top;fontStyle=1;" vertex="1" parent="1">
